#!/usr/bin/env python3
"""Collect Pi agent usage into the omarchy.agents record contract.

Scans ~/.pi/agent/sessions (and ~/.omp) for assistant messages and writes
~/.local/state/omarchy/agents/usage/pi.json, which the stock omarchy.agents
panel displays.

Why this exists
---------------
Omarchy's stock collectors only count pi sessions whose provider is
``anthropic`` (claude collector) or ``openai-codex`` (codex collector). A pi
configured with any other backend -- opencode, openrouter, ... -- is
invisible, every record stays at zero, and the whole agents widget self-hides.
This collector is provider-agnostic and writes its own record so pi always
shows up.

There is no limits/balance section: pi has no usage endpoint, so the tab is
local token stats only.

Environment
-----------
PI_AGENT_PROVIDERS
    Optional comma-separated allow-list of pi provider ids, e.g.
    ``opencode`` or ``opencode,openrouter``. Unset/empty means "all".
"""

import json
import os
import tempfile
from datetime import datetime, timedelta
from pathlib import Path

STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
    / "omarchy"
    / "agents"
    / "usage"
)
RECORD = STATE_DIR / "pi.json"
ROOTS = [
    Path.home() / ".pi" / "agent" / "sessions",
    Path.home() / ".omp" / "agent" / "sessions",
]
WINDOW_DAYS = 7
PROVIDERS = {
    part.strip()
    for part in os.environ.get("PI_AGENT_PROVIDERS", "").split(",")
    if part.strip()
}


def number(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def local_day(value):
    if value is None:
        return datetime.now().strftime("%Y-%m-%d")
    if isinstance(value, (int, float)):
        # pi message timestamps are milliseconds; some sources use seconds.
        if value > 10_000_000_000:
            value = value / 1000
        return datetime.fromtimestamp(value).strftime("%Y-%m-%d")
    text = str(value)
    try:
        if text.endswith("Z"):
            dt = datetime.fromisoformat(text[:-1] + "+00:00")
        else:
            dt = datetime.fromisoformat(text)
        if dt.tzinfo is not None:
            dt = dt.astimezone()
        return dt.strftime("%Y-%m-%d")
    except Exception:
        return datetime.now().strftime("%Y-%m-%d")


def model_name(value):
    return str(value or "unknown").rstrip("/").split("/")[-1] or "unknown"


def empty_bucket():
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def collect():
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    recent_dates = [
        (now - timedelta(days=i)).strftime("%Y-%m-%d")
        for i in range(WINDOW_DAYS - 1, -1, -1)
    ]
    recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

    model_usage = {}
    sessions = set()
    active_dates = set()
    today_sessions = set()
    today_tokens_by_model = {}
    today_prompts = 0
    today_total = 0
    total_prompts = 0
    seen = set()

    for root in ROOTS:
        if not root.is_dir():
            continue
        for path in root.rglob("*.jsonl"):
            try:
                handle = path.open("r", encoding="utf-8", errors="replace")
            except OSError:
                continue
            with handle:
                for line_number, line in enumerate(handle, 1):
                    # Cheap gates before the JSON parse.
                    if '"usage"' not in line or '"assistant"' not in line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue
                    if entry.get("type") != "message":
                        continue
                    message = entry.get("message") or {}
                    if message.get("role") != "assistant":
                        continue
                    if PROVIDERS and str(message.get("provider") or "") not in PROVIDERS:
                        continue
                    usage = message.get("usage") or {}
                    if not usage:
                        continue

                    # Same message can appear once; key on file + message id.
                    key = f"{path}:{entry.get('id') or line_number}"
                    if key in seen:
                        continue
                    seen.add(key)

                    input_tokens = number(usage.get("input"))
                    output_tokens = number(usage.get("output"))
                    cache_read = number(usage.get("cacheRead"))
                    cache_write = number(usage.get("cacheWrite"))
                    if not (input_tokens or output_tokens or cache_read or cache_write):
                        input_tokens = number(usage.get("totalTokens"))
                    if not (input_tokens or output_tokens or cache_read or cache_write):
                        continue
                    total = input_tokens + output_tokens + cache_read + cache_write

                    model = model_name(message.get("model"))
                    day = local_day(entry.get("timestamp") or message.get("timestamp"))
                    session_key = str(path)

                    sessions.add(session_key)
                    active_dates.add(day)
                    total_prompts += 1

                    bucket = model_usage.setdefault(model, empty_bucket())
                    bucket["inputTokens"] += input_tokens
                    bucket["outputTokens"] += output_tokens
                    bucket["cacheReadInputTokens"] += cache_read
                    bucket["cacheCreationInputTokens"] += cache_write

                    if day in recent:
                        recent[day]["messageCount"] += total
                    if day == today:
                        today_prompts += 1
                        today_sessions.add(session_key)
                        today_total += total
                        today_tokens_by_model[model] = (
                            today_tokens_by_model.get(model, 0) + total
                        )

    return {
        "schemaVersion": 1,
        "id": "pi",
        "name": "Pi",
        "updatedAt": now.astimezone().isoformat(),
        "ready": True,
        "hasLocalStats": total_prompts > 0,
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[day] for day in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(sessions),
        "activeDays": len(active_dates),
        "activeDates": sorted(active_dates),
        "modelUsage": model_usage,
        "limits": [],
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
    }


def write(record):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".pi.", suffix=".json")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(record, fh, ensure_ascii=False)
        os.chmod(tmp, 0o600)
        os.replace(tmp, RECORD)
    except Exception:
        os.unlink(tmp)
        raise


def main():
    record = collect()
    write(record)
    scope = ",".join(sorted(PROVIDERS)) if PROVIDERS else "all providers"
    print(
        f"pi ({scope}): {record['totalPrompts']} prompts, "
        f"{record['totalSessions']} sessions -> {RECORD}"
    )


if __name__ == "__main__":
    main()
